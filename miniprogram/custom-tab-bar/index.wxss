.tab-bar{position:fixed;bottom:0;left:0;right:0;z-index:99;display:flex;align-items:stretch;background:#fff;border-top:1rpx solid #e0e7e2;padding:12px 8px calc(10px + env(safe-area-inset-bottom));box-sizing:border-box}.tab-item{width:25%;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:4px;margin:0;padding:0;min-height:56px;font-size:14px;line-height:1.3;color:#626f65;background:none;border-radius:0;font-weight:500}.tab-item::after{border:none}.nav-icon{padding:2px 14px;border-radius:10px;display:flex}.nav-icon image{width:28px;height:28px}.active{color:#087649;font-weight:600}.active .nav-icon{background:#dbf5e5}
