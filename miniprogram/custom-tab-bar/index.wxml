<view class="tab-bar"><button wx:for="{{tabs}}" wx:key="pagePath" class="tab-item {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="switchTab" aria-label="{{item.text}}" aria-current="{{selected === index ? 'page' : 'false'}}"><view class="nav-icon"><image src="/assets/editorial/{{item.icon}}{{selected === index ? '-selected' : ''}}.png"/></view><text>{{item.text}}</text></button></view>
