<view class="page"><view class="title">连接申请管理</view><view class="notice">仅运营可见。请先在双方确认后，再用独立渠道安排交流；此处不会显示或交换联系方式。</view><view wx:if="{{status === 'loading'}}" class="state">加载中…</view><view wx:elif="{{status === 'error'}}" class="state"><view class="status-empty-title">暂时无法加载申请</view><view>{{error}}</view><button class="primary" bindtap="load">重试</button></view><view wx:elif="{{status === 'empty'}}" class="state"><view class="status-empty-title">暂无连接申请</view><view class="muted">收到申请后，先确认方向、边界和双方交流意愿，再安排连接。</view></view><view wx:else><view wx:for="{{items}}" wx:key="id" class="card"><view class="subtitle">{{item.profileSummary.displayName}} · {{item.intent === 'share' ? '愿意分享' : '希望交流'}}</view><view class="muted">{{item.profileSummary.organization}} · {{item.profileSummary.specialty}}</view><view class="field"><text class="label">背景</text>{{item.introduction}}</view><view class="field"><text class="label">问题</text>{{item.question}}</view><view wx:if="{{item.availability}}" class="field"><text class="label">可交流时间</text>{{item.availability}}</view><view class="notice">当前：{{statusLabel[item.status]}}</view><button wx:if="{{item.status !== 'reviewing'}}" class="secondary" data-id="{{item.id}}" data-status="reviewing" loading="{{busyId === item.id}}" bindtap="review">标为审核中</button><button wx:if="{{item.status !== 'closed'}}" class="secondary" data-id="{{item.id}}" data-status="closed" loading="{{busyId === item.id}}" bindtap="review">结束本次申请</button></view></view></view>
