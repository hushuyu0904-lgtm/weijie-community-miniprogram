<view class="page">
  <view class="title">我的</view>
  <view class="notice">身份和权限由服务端验证，不提供模拟管理员。</view>
  <view wx:if="{{status === 'loading'}}" class="state">正在验证微信身份…</view>
  <view wx:elif="{{status === 'error'}}" class="card state"><view>{{error}}</view><button class="primary" bindtap="loadIdentity">重试</button></view>
  <view wx:else class="card">
    <view class="subtitle">{{identity.role === 'admin' ? '管理员' : identity.canBrowse ? '社群成员' : '尚未获准访问社群'}}</view>
    <view class="muted">{{identity.canBrowse ? '身份已由云函数确认' : '请将身份编号交给运营者核实，加入后重新验证。'}}</view>
    <view class="field body"><text class="label">本人身份编号（仅用于成员登记，不是登录凭据）</text>{{identity.memberKey}}</view>
    <button class="secondary" bindtap="copyIdentity">复制身份编号</button>
    <button class="secondary" bindtap="loadIdentity">重新验证身份</button>
    <button wx:if="{{identity.role === 'admin'}}" class="primary" bindtap="openManage">活动管理</button>
  </view>
  <view class="closed">我的报名、退款与其他管理功能尚未开放</view>
</view>
