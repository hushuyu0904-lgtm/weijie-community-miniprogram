<view class="tab-page"><view class="masthead"><view class="kicker">未界 / MY SPACE</view><view class="profile-heading"><view><view class="page-heading">我的</view><view class="deck editorial">把你的故事留在这里。</view></view><view class="profile-avatar-wrap"><view class="profile-icon" bindtap="openOnboarding"><image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill"/><text wx:else>{{avatarLetter}}</text></view><button class="avatar-edit-link" bindtap="openOnboarding">编辑头像</button></view></view></view><view class="page-body">
  <view wx:if="{{status === 'loading'}}" class="state">正在验证微信身份…</view>
  <view wx:elif="{{status === 'error'}}" class="card state"><view>{{error}}</view><button class="primary" bindtap="loadIdentity">重试</button></view>
  <block wx:else>
    <view wx:if="{{!identity.canBrowse || !identity.hasProfile}}" class="card">
      <view class="subtitle">建立你的职业档案</view>
      <view class="muted">完善背景与探索方向后，未界才能推荐更相关的活动、资源与连接机会。</view>
      <button class="primary" bindtap="openOnboarding">开始填写</button>
    </view>
    <block wx:else>
      <view class="card">
        <view class="subtitle">{{identity.profile.displayName}}的职业档案</view>
        <view class="field"><text class="label">当前阶段</text>{{stageLabel}}</view>
        <view class="field"><text class="label">学校或单位</text>{{identity.profile.organization}}</view>
        <view class="field"><text class="label">专业或岗位方向</text>{{identity.profile.specialty}}</view>
        <view class="field"><text class="label">所在城市</text>{{identity.profile.city}}</view>
        <view class="field"><text class="label">感兴趣方向</text>{{directionLabels}}</view>
        <button class="secondary" bindtap="openOnboarding">编辑职业档案</button>
      </view>
      <view class="card"><view class="subtitle">我的参与</view><button class="secondary" bindtap="openRegistrations">我的报名</button><button class="secondary" bindtap="openConnections">我的连接申请</button><view class="muted">提交申请后，未界会协助安排后续交流。</view></view>
      <view class="card"><view class="subtitle">机会接收偏好</view><view class="muted">{{identity.opportunityOptIn ? '已同意接收相关活动与机会通知。' : '目前未订阅相关活动与机会通知。'}}</view></view>
    </block>
    <view wx:if="{{identity.role === 'admin'}}" class="card"><view class="subtitle">运营管理</view><button class="primary" bindtap="openManage">活动管理</button><button class="secondary" bindtap="openResourceManage">资源管理</button><button class="secondary" bindtap="openConnectionManage">连接申请管理</button><view class="operator-code"><view class="label">运营协作码</view><view class="muted">如需环境维护或管理员协作，可复制此编号给项目负责人。</view><button class="link-button" bindtap="copyIdentity">复制协作码</button></view></view>
    <view class="card"><view class="subtitle">使用与数据</view><view class="muted">了解我们收集什么信息、如何使用，以及如何反馈或提出删除请求。</view><button class="secondary" bindtap="openPrivacy">隐私与数据说明</button><button class="secondary" bindtap="openHelp">使用说明与反馈</button></view>
  </block>
</view>
</view>
