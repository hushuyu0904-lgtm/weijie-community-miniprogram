.profile-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.profile-avatar-wrap{display:flex;flex-direction:column;align-items:center;gap:5rpx}.profile-icon{width:112rpx;height:112rpx;border-radius:50%;background:linear-gradient(135deg,#1b7653,#70b992);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 8rpx 18rpx #2874512e}.profile-icon text{font-family:"Songti SC","STSong",serif;color:#fff;font-size:52rpx;font-weight:700;line-height:1}.profile-icon image{display:block;width:100%;height:100%;border-radius:50%}.avatar-edit-link{margin:0;min-height:unset;padding:0;background:transparent;color:#3b6750;font-size:21rpx;line-height:1.3;text-decoration:underline}.mine-note{margin-top:30rpx}.body{word-break:break-all}
