.profile-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.profile-heading>view:first-child{flex:1;min-width:0}.profile-heading .deck{white-space:nowrap;font-size:25rpx}.profile-avatar-wrap{display:flex;flex-direction:column;align-items:center;gap:5rpx}.profile-icon{width:112rpx;height:112rpx;border-radius:50%;background:#293f33;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:none;border:3rpx solid #f9f8f3}.profile-icon text{font-family:"Songti SC","STSong",serif;color:#fff;font-size:52rpx;font-weight:700;line-height:1}.profile-icon image{display:block;width:100%;height:100%;border-radius:50%}.avatar-edit-link{margin:0;min-height:unset;padding:0;background:transparent;color:#3b4e40;font-size:21rpx;line-height:1.3;text-decoration:underline}.operator-code{margin-top:26rpx;padding-top:22rpx;border-top:1rpx solid #dad8d0}.operator-code .link-button{margin-bottom:0}.mine-note{margin-top:30rpx}.body{word-break:break-all}
