<view class="page"><view class="title">资源管理</view><view wx:if="{{status === 'loading'}}" class="state">正在验证权限…</view><view wx:elif="{{status === 'error'}}" class="state"><view>{{error}}</view><button class="primary" bindtap="load">重试</button></view><view wx:else><button class="primary" bindtap="create">新建资源</button><view wx:if="{{!items.length}}" class="state">暂无草稿或已发布资源。</view><button wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="subtitle">{{item.title}}</view><view class="muted">{{item.category}} · {{item.status === 'published' ? '已发布' : '草稿'}}</view></button></view></view>
