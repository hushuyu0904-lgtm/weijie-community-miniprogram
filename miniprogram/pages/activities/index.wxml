<view class="home tab-page">
<view class="hero-header"><view class="brand-row"><view class="brand">未界<text>WEIJIE</text></view><view class="edition">活动 · 见面 · 交流</view></view><view class="slogan editorial">相似的背景，不一样的故事。</view><view class="source">{{sourceLabel}}</view>
<view class="hero-pair"><view class="hero"><image wx:if="{{!heroFailed}}" src="/assets/editorial/coffee-chat.jpg" mode="aspectFill" class="hero-art" binderror="onHeroError"/><view class="hero-shade"></view><view class="hero-copy"><view class="eyebrow">Coffee Chat</view><view class="hero-title">一杯咖啡，<view>聊聊下一步。</view></view></view><text class="photo-note">图库配图 · 非活动现场</text></view><view class="hero-topic poster-ai"><view class="poster-label">职业探索</view><view class="poster-big">医学<view>× <text>AI</text></view></view><view class="poster-rule"></view><view class="poster-caption">从临床问题<view>到产品思考</view></view><view class="poster-end">主题海报</view></view></view>
<view class="categories"><button class="category all-category {{category === 'all' ? 'selected' : ''}}" data-id="all" bindtap="selectCategory">全部</button><button wx:for="{{categories}}" wx:key="id" class="category {{category === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectCategory"><image src="/assets/editorial/{{item.id}}.png"/><text>{{item.label}}</text></button></view></view>
<view class="content"><view class="section-heading"><view class="section-title">近期活动<text class="section-dot"></text></view><text class="section-sub">见面，让故事发生</text></view>
<view wx:if="{{status === 'loading'}}" class="state">加载中…</view><view wx:elif="{{status === 'empty'}}" class="state">暂无活动<button class="secondary" bindtap="loadActivities">重新加载</button></view><view wx:elif="{{status === 'error'}}" class="state"><view>{{error}}</view><view class="muted">身份与成员资格可在“我的”查看。</view><button class="primary" bindtap="loadActivities">重试</button></view>
<block wx:else><view wx:if="{{category === 'outing' || category === 'chat'}}" class="state">暂无此类演示活动</view><block wx:for="{{items}}" wx:key="id"><view wx:if="{{category === 'all' || item.category === category}}" class="activity-card">
<view class="cover"><view wx:if="{{item.isDemo && item.category === 'lecture'}}" class="poster-ai card-poster"><view class="poster-label">MEDICAL / AI</view><view class="poster-big">医学<view>× <text>AI</text></view></view><view class="poster-rule"></view><view class="poster-caption">临床问题<view>数据 · 产品</view></view><view class="poster-end">原创主题海报</view></view><block wx:elif="{{item.isDemo}}"><image wx:if="{{!failedCovers[item.id]}}" src="/assets/editorial/coffee-chat.jpg" mode="aspectFill" binderror="onCoverError" data-id="{{item.id}}"/><text class="photo-note">图库主题配图</text></block><view wx:else class="poster-neutral">未界<view>活动</view><view class="small">暂无活动封面</view></view></view>
<view class="activity-copy"><view class="date">{{item.dateLabel || '待定'}}<text>活动日期</text></view><view class="activity-title">{{item.title}}</view><view wx:if="{{item.isDemo}}" class="tag">{{item.category === 'lecture' ? '线上讲座' : '线下 Coffee Chat'}} · 演示</view><view class="meta"><image src="/assets/editorial/calendar.png"/><text>{{item.timeText}}</text></view><view class="meta"><image src="/assets/editorial/pin.png"/><text>{{item.location}}</text></view><view class="meta"><image src="/assets/editorial/person.png"/><text>人数上限 {{item.capacity}} 人{{item.isDemo ? '（示例）' : ''}}</text></view><view class="footer"><text class="fee">{{item.priceText}}</text><button data-id="{{item.id}}" bindtap="openActivity" aria-label="查看活动：{{item.title}}">查看详情 →</button></view></view></view></block><view wx:if="{{moreError}}" class="state">{{moreError}}</view><button wx:if="{{hasMore}}" class="secondary" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">{{moreError ? '重试加载更多' : '加载更多'}}</button></block><view class="footnote">报名功能尚未开放。活动时间、地点与参与安排以正式发布信息为准。</view></view></view>
