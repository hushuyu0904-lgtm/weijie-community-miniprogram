<view class="home">
<view class="hero-header">
<view class="brand-row"><view class="brand"><text class="brand-mark">↗</text> 未界</view><view class="edition">WEIJIE · CONNECTION</view></view>
<view class="slogan">从医学出发，<view>遇见<text class="highlight">更多可能。</text></view></view>
<view class="source">{{sourceLabel}}</view>
<view class="hero"><image src="/assets/scene.png" mode="aspectFill" class="hero-art"/><view class="hero-copy"><view class="eyebrow">MEET · TALK · EXPLORE</view><view class="hero-title">一杯咖啡，<view>聊聊下一步。</view></view><view class="hero-caption">原创插画 · 非活动现场</view></view></view>
<view class="categories"><button wx:for="{{categories}}" wx:key="id" class="category {{category === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectCategory" aria-label="{{item.label}}"><view class="icon-box"><image src="/assets/{{item.id}}.png"/></view><view>{{item.label}}</view></button></view>
</view>
<view class="content"><view class="section-heading"><view class="section-title"><image src="/assets/calendar.png"/><text>近期活动</text></view><button class="all" data-id="all" bindtap="selectCategory">全部活动</button></view>
<view wx:if="{{status === 'loading'}}" class="state">加载中…</view>
<view wx:elif="{{status === 'empty'}}" class="state">暂无活动<button class="secondary" bindtap="loadActivities">重新加载</button></view>
<view wx:elif="{{status === 'error'}}" class="state"><view>{{error}}</view><view class="muted">身份与成员资格可在“我的”查看。</view><button class="primary" bindtap="loadActivities">重试</button></view>
<block wx:else>
<view wx:if="{{category === 'outing' || category === 'chat'}}" class="state">暂无此类演示活动</view>
<block wx:for="{{items}}" wx:key="id"><view wx:if="{{category === 'all' || item.category === category}}" class="activity-card">
<view class="cover"><image src="/assets/{{item.cover || 'scene'}}.png" mode="aspectFill"/><text class="cover-caption">{{item.isDemo ? '原创封面 · 示例活动' : '原创主题封面'}}</text></view>
<view class="activity-copy"><view class="date">{{item.dateLabel || '待定'}}</view><view class="activity-title">{{item.title}}</view>
<view wx:if="{{item.isDemo}}" class="tag">{{item.category === 'lecture' ? '线上讲座' : '线下 Coffee Chat'}} · 演示</view>
<view class="meta"><image src="/assets/calendar.png"/><text>{{item.timeText}}</text></view><view class="meta"><image src="/assets/pin.png"/><text>{{item.location}}</text></view><view class="meta"><image src="/assets/person.png"/><text>人数上限 {{item.capacity}} 人{{item.isDemo ? '（示例）' : ''}}</text></view>
<view class="footer"><text class="fee">{{item.priceText}}</text><button data-id="{{item.id}}" bindtap="openActivity" aria-label="查看活动：{{item.title}}">查看详情 →</button></view></view></view></block>
<view wx:if="{{moreError}}" class="state">{{moreError}}</view><button wx:if="{{hasMore}}" class="secondary" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">{{moreError ? '重试加载更多' : '加载更多'}}</button>
</block><view class="footnote">报名功能尚未开放。活动时间、地点与参与安排以正式发布信息为准。</view></view></view>
