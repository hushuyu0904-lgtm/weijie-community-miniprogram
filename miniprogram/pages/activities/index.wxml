<view class="page">
  <view class="brand">未界</view>
  <view class="muted">医学背景 · 更多可能</view>
  <view class="notice">{{sourceLabel}}</view>
  <view class="title">活动</view>
  <view wx:if="{{status === 'loading'}}" class="state">加载中…</view>
  <view wx:elif="{{status === 'empty'}}" class="state">
    <view>暂无活动</view>
    <button class="secondary" bindtap="loadActivities">重新加载</button>
  </view>
  <view wx:elif="{{status === 'error'}}" class="state">
    <view>{{error}}</view>
    <view class="muted">身份与成员资格可在“我的”查看。</view>
    <button class="primary" bindtap="loadActivities">重试</button>
  </view>
  <block wx:else>
    <view wx:for="{{items}}" wx:key="id" class="card">
      <view class="muted">{{item.isDemo ? '示例活动 · ' : ''}}报名尚未开放</view>
      <view class="subtitle">{{item.title}}</view>
      <view>{{item.timeText}}</view>
      <view class="muted">{{item.location}}</view>
      <view class="price">{{item.priceText}}</view>
      <view wx:if="{{item.isDemo}}">剩余 {{item.remaining}} / {{item.capacity}} 个名额（示例）</view>
      <view wx:else>人数上限 {{item.capacity}} 人 · 报名尚未开放</view>
      <view class="muted">{{item.deadlineText}}</view>
      <button class="primary" data-id="{{item.id}}" bindtap="openActivity">查看活动</button>
    </view>
    <view wx:if="{{moreError}}" class="state">{{moreError}}</view>
    <button wx:if="{{hasMore}}" class="secondary" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">{{moreError ? '重试加载更多' : '加载更多'}}</button>
  </block>
</view>
