page{background:#fff}.hero-header{padding:28rpx 26rpx 0;background:radial-gradient(ellipse at 90% 0,#c0f4ee,transparent 65%),linear-gradient(130deg,#b4ecd1,#eef7f0)}.brand-row{display:flex;align-items:center;justify-content:space-between}.brand{font-size:52rpx;font-weight:800;letter-spacing:2rpx;line-height:1.2}.brand text{font-family:Arial,sans-serif;font-size:19rpx;font-weight:600;letter-spacing:3rpx;margin-left:16rpx}.edition{font-size:22rpx;color:#43614e}.slogan{font-size:31rpx;margin:16rpx 0 8rpx;color:#294a35}.source{font-size:22rpx;color:#42644e;margin-bottom:20rpx}.hero-pair{display:flex;gap:16rpx}.hero{width:62%;position:relative;height:380rpx;background:#244f3a;border-radius:12rpx;overflow:hidden}.hero-art{width:100%;height:100%;position:absolute}.hero-shade{position:absolute;inset:0;background:linear-gradient(0deg,#10251fdd,transparent 90%)}.hero-copy{position:absolute;bottom:56rpx;left:22rpx;color:#fff}.eyebrow{font-size:23rpx;font-family:Arial,sans-serif;font-style:italic;font-weight:600;letter-spacing:1rpx}.hero-title{font-size:42rpx;line-height:1.28;font-weight:800;margin-top:12rpx}.hero-topic{height:380rpx;box-sizing:border-box;flex:1;min-width:0;border-radius:12rpx;padding:23rpx 19rpx}.categories{display:flex;gap:12rpx;flex-wrap:wrap;padding:24rpx 0 30rpx}.category{display:flex;align-items:center;justify-content:center;gap:9rpx;margin:0;padding:15rpx 17rpx;min-height:88rpx;border-radius:9rpx;font-size:27rpx;font-weight:600;background:#ffffffdc;color:#263e2e}.category image{width:38rpx;height:38rpx}.category.selected{background:#18e98b;color:#063e26}.all-category{padding:15rpx 22rpx}.content{padding:28rpx 26rpx 12rpx}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:24rpx}.section-title{font-size:39rpx;font-weight:800;display:flex;align-items:center;gap:12rpx}.section-dot{width:13rpx;height:13rpx;background:#18d27e;border-radius:50%}.section-sub{font-size:23rpx;color:#58695d}.activity-card{display:flex;gap:24rpx;padding-bottom:28rpx;margin-bottom:28rpx;border-bottom:1rpx solid #e5eae6}.cover{position:relative;width:40%;flex-shrink:0;min-height:465rpx;background:#d6e8dc;border-radius:12rpx;overflow:hidden}.cover>image{position:absolute;width:100%;height:100%;object-position:42% center}.poster-neutral{height:100%;box-sizing:border-box;line-height:1.7}.activity-copy{min-width:0;flex:1}.date{font-family:"Arial Narrow",Arial,sans-serif;font-size:56rpx;font-weight:800;line-height:1.1;color:#535f56;margin-bottom:15rpx}.date text{font-family:inherit;font-size:21rpx;font-weight:400;margin-left:12rpx;color:#59695e}.activity-title{font-size:34rpx;font-weight:700;line-height:1.42;margin-bottom:14rpx;overflow-wrap:break-word}.tag{display:inline-block;background:#e5f2e9;color:#286647;font-size:21rpx;padding:3rpx 8rpx;border-radius:4rpx}.meta{display:flex;gap:8rpx;margin-top:16rpx;font-size:24rpx;color:#56665b;line-height:1.5}.meta image{width:30rpx;height:30rpx;flex-shrink:0;margin-top:3rpx}.meta text{overflow-wrap:break-word}.footer{display:flex;align-items:center;justify-content:space-between;gap:5rpx;margin-top:10rpx}.fee{font-size:30rpx;font-weight:700;color:#087847}.footer button{margin:0;padding:20rpx 0;min-height:88rpx;color:#28543e;background:transparent;font-size:24rpx}.footnote{font-size:24rpx;color:#5b685f;padding:14rpx 0 28rpx;line-height:1.7}@media(max-width:340px){.activity-title{font-size:34rpx}.cover{width:37%;min-height:540rpx}.meta{font-size:25rpx}.date text{display:block;margin:5rpx 0 0}.hero-title{font-size:40rpx}.category{font-size:28rpx}}

.hero-topic.llm-frame{padding:0}.llm-card{position:absolute;inset:0;width:100%;height:100%}
