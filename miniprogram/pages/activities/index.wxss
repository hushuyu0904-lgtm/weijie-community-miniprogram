.brand { font-size: 40rpx; letter-spacing: 4rpx; }
.section-heading { margin: 36rpx 0 24rpx; }
.section-heading .title { font-size: 36rpx; margin-bottom: 4rpx; }
.activity-card { margin: 24rpx 0; }
.activity-label { color: #7046ac; font-size: 24rpx; font-weight: 600; margin-bottom: 16rpx; }
.activity-summary { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; margin-bottom: 24rpx; }
.activity-meta { margin: 12rpx 0; font-size: 28rpx; }
.activity-meta .label { display: inline; margin-right: 20rpx; }
.activity-footer { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-top: 1rpx solid #e8e1ed; padding-top: 24rpx; margin-top: 24rpx; }
.activity-footer .price { margin: 0; }
.detail-link { margin: 0; font-size: 28rpx; flex-shrink: 0; }
