page{background:#fff;color:#162f32}.hero-header{padding:36rpx 32rpx 0;background:radial-gradient(ellipse at 95% 5%,#c9f0fd,transparent 58%),radial-gradient(ellipse at 6% 70%,#d4f5a8,transparent 63%),linear-gradient(135deg,#50bda9,#b5f4df)}
.brand-row,.section-heading,.section-title{display:flex;align-items:center;justify-content:space-between}.brand{font-size:48rpx;letter-spacing:4rpx;font-weight:800}.brand-mark{display:inline-block;text-align:center;width:64rpx;height:64rpx;background:#153e3c;color:#baffbd;border-radius:18rpx}.edition{color:#315b58;font-size:18rpx}.slogan{font-size:52rpx;line-height:1.35;font-weight:800;margin:40rpx 0 16rpx}.highlight{box-shadow:inset 0 -15rpx #edfa75}.source{font-size:22rpx;color:#365b55;margin-bottom:26rpx}
.hero{position:relative;height:310rpx;background:#153f48;color:#fff;border-radius:26rpx;overflow:hidden}.hero-art{position:absolute;right:0;width:46%;height:100%}.hero-copy{position:relative;padding:32rpx 24rpx;width:58%}.eyebrow{font-size:17rpx;color:#bbf5db}.hero-title{font-size:44rpx;line-height:1.3;font-weight:800;margin:22rpx 0}.hero-caption{font-size:17rpx;color:#d5e8e5}
.categories{display:flex;padding:34rpx 0}.category{width:25%;margin:0;padding:0 3rpx;background:transparent;color:#264e4b;border-radius:0;font-size:20rpx;min-height:0}.icon-box{width:90rpx;height:88rpx;border-radius:24rpx;margin:0 auto 12rpx;background:#ffffffad;display:flex;align-items:center;justify-content:center}.icon-box image{width:54rpx;height:54rpx}.selected .icon-box{background:#fff;box-shadow:0 5rpx 0 #259a79}
.content{position:relative;background:#fff;border-radius:40rpx 40rpx 0 0;padding:32rpx 26rpx;margin-top:-2rpx}.section-heading{margin-bottom:26rpx}.section-title{font-size:34rpx;font-weight:700}.section-title image{width:44rpx;height:44rpx;margin-right:12rpx}.section-title text{box-shadow:inset 0 -10rpx #eef7a0}.all{margin:0;padding:16rpx;min-height:72rpx;font-size:23rpx;background:#e8f6ef;color:#267257}
.activity-card{display:flex;overflow:hidden;border-radius:26rpx;background:#f8faf9;margin-bottom:26rpx;border:1rpx solid #edf1ef}.cover{width:40%;flex-shrink:0;position:relative;min-height:440rpx;background:#d9eee2}.cover image{position:absolute;width:100%;height:100%}.cover-caption{position:absolute;bottom:16rpx;left:10rpx;padding:5rpx 8rpx;background:#ffffffdd;border-radius:6rpx;font-size:17rpx}.activity-copy{flex:1;min-width:0;padding:24rpx 18rpx}.date{font-family:Arial,sans-serif;font-size:54rpx;line-height:1.1;font-weight:800;margin-bottom:16rpx}.activity-title{font-size:30rpx;line-height:1.5;font-weight:700;overflow-wrap:break-word;margin-bottom:14rpx}.tag{display:inline-block;font-size:19rpx;background:#dbf1e7;color:#236c52;padding:4rpx 8rpx;border-radius:6rpx}.meta{display:flex;align-items:flex-start;color:#526969;font-size:21rpx;margin-top:14rpx}.meta image{width:28rpx;height:28rpx;flex-shrink:0;margin:3rpx 7rpx 0 0}.meta text{overflow-wrap:break-word}.footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;margin-top:12rpx}.fee{color:#187552;font-size:26rpx;font-weight:700}.footer button{margin:0;padding:20rpx 0;min-height:80rpx;background:transparent;color:#345a58;font-size:22rpx}.footnote{font-size:22rpx;color:#526969;background:#f1f7f5;padding:20rpx;border-radius:16rpx}.primary{background:#187552}.secondary{background:#e8f6ef;color:#267257}
