<view class="page"><view class="title">我的连接申请</view><view wx:if="{{status === 'loading'}}" class="state">加载中…</view><view wx:elif="{{status === 'error'}}" class="state"><view class="status-empty-title">暂时无法加载申请</view><view>{{error}}</view><button class="primary" bindtap="load">重试</button></view><view wx:elif="{{status === 'empty'}}" class="state"><view class="status-empty-title">还没有连接申请</view><view class="muted">先写下你想聊的方向和问题，运营会在双方确认意愿后安排连接。</view><button class="primary" bindtap="revise">填写交流申请</button></view><view wx:else><view wx:for="{{items}}" wx:key="id" class="card"><view class="subtitle">{{item.intent === 'share' ? '我愿意分享经历' : '我希望寻找相似背景的人聊聊'}}</view><view class="notice">{{statusLabel[item.status]}}</view><view class="field"><text class="label">希望交流的问题</text>{{item.question}}</view><view wx:if="{{item.operatorNote}}" class="field"><text class="label">运营备注</text>{{item.operatorNote}}</view><button class="secondary" bindtap="revise">更新这份申请</button></view></view></view>
