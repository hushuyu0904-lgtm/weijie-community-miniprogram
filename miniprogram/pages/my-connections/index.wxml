<view class="page"><view class="title">我的连接申请</view><view wx:if="{{status === 'loading'}}" class="state">加载中…</view><view wx:elif="{{status === 'error'}}" class="state"><view>{{error}}</view><button class="primary" bindtap="load">重试</button></view><view wx:elif="{{status === 'empty'}}" class="state">你还没有提交连接申请。<button class="primary" bindtap="revise">去填写申请</button></view><view wx:else><view wx:for="{{items}}" wx:key="id" class="card"><view class="subtitle">{{item.intent === 'share' ? '我愿意分享经历' : '我希望寻找相似背景的人聊聊'}}</view><view class="notice">{{statusLabel[item.status]}}</view><view class="field"><text class="label">问题</text>{{item.question}}</view><view wx:if="{{item.operatorNote}}" class="field"><text class="label">运营备注</text>{{item.operatorNote}}</view><button class="secondary" bindtap="revise">更新这份申请</button></view></view></view>
