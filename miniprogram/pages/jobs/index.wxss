page{background:#faf9f6}.resource-page-body{padding-left:0;padding-right:0}.resource-page-body>.resource-scroll,.resource-page-body>.state,.resource-page-body>.notice,.resource-page-body>.secondary{margin-left:32rpx;margin-right:32rpx}.resource-filters{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;width:100%;box-sizing:border-box;white-space:normal}.resource-filter{display:flex;width:100%;min-width:0;min-height:42px;margin:0;padding:7px 2px;box-sizing:border-box;justify-content:center;gap:3px;background:transparent;border:1px solid #cbc9c0;border-radius:3px;color:#4a514a;font-size:11px;line-height:1.15}.resource-filter image{display:block;width:14px;height:14px;flex:none}.resource-filter text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.resource-filter.selected{background:#263c31;color:#fff;border-color:#263c31}.resource-card{display:block;width:100%;box-sizing:border-box;background:transparent;margin:0;padding:22px 32rpx;border-bottom:1px solid #d9d8d0}.resource-row{display:flex;align-items:stretch;gap:16px;width:100%;min-width:0}.resource-media{width:250rpx;height:216rpx;flex:none;background:#e9e7df;overflow:hidden}.resource-copy{min-width:0;flex:1;display:flex;flex-direction:column}.resource-cover-thumb{display:block;width:100%;height:100%;border-radius:0;background:#e9e7df;margin:0}.resource-cover-fallback{width:100%;height:100%;box-sizing:border-box;padding:16rpx;background:linear-gradient(125deg,#e8e5dc,#d8ddd4);display:flex;flex-direction:column;justify-content:space-between;color:#324438;font-family:"Songti SC","STSong",serif}.resource-cover-fallback text:first-child{font-size:30rpx;font-weight:700}.resource-cover-fallback text:last-child{font-size:19rpx;letter-spacing:2rpx}.source-top{gap:7px;color:#61665f}.source-avatar{width:23px;height:23px;border-radius:50%;background:#d9ddd4;color:#34483a;display:flex;align-items:center;justify-content:center;font-family:"Songti SC","STSong",serif;font-weight:700;font-size:12px;flex:none}.source-meta{display:flex;align-items:baseline;gap:5px;min-width:0}.source-name{font-size:11px;color:#4c544d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.source-type{font-size:10px;color:#8a8c84}.source-title{font-family:"Songti SC","STSong","SimSun",serif;font-size:18px;line-height:1.4;margin:7px 0 4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.source-desc{font-size:11px;line-height:1.55;color:#666963;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.source-action{color:#263c31;font-size:11px;font-weight:500;margin-top:auto;padding-top:4px;min-height:unset}.source-action text{margin-left:5px}

/* Keep the resource filters on the same compact flex rhythm as activities. */
.resource-filters{display:flex;gap:4px;width:100%;box-sizing:border-box;white-space:normal}.resource-filter{display:flex;flex:1;min-width:0;min-height:44px;margin:0;padding:8px 0;box-sizing:border-box;align-items:center;justify-content:center;gap:2px;font-size:13px;line-height:1.2}.resource-filter image{display:block;width:14px;height:14px;flex-shrink:0}.resource-filter text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* Five compact filters: same rhythm as the activity navigation, with a shared all view. */
.resource-filters{display:flex;gap:6rpx;width:100%;box-sizing:border-box}.resource-filter{flex:1 1 0;width:0;min-width:0;min-height:88rpx;padding:12rpx 0;font-size:23rpx;gap:3rpx;box-sizing:border-box}.resource-filter image{width:26rpx;height:26rpx;flex:none}.resource-filter text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* Five filters fit on one line; “all” intentionally has no duplicate icon. */
.resource-filters{gap:4rpx}.resource-filter{flex:1 1 0;width:0;min-width:0;min-height:84rpx;padding:10rpx 0;font-size:22rpx;gap:2rpx}.resource-filter image{width:24rpx;height:24rpx;flex:none}
