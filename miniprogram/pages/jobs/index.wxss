.resource-feature{background:#edf3ef;color:#24392c;position:relative;padding:0;overflow:hidden}.feature-title{font-size:43rpx;margin:24rpx 28rpx 18rpx}.feature-desc{font-size:28rpx;line-height:1.7;margin:0 28rpx 22rpx;color:#3b5142}.resource-caption{font-size:23rpx;color:#657267;margin:16rpx 0 26rpx}.mini-tile .status-pill{display:inline-block;margin-top:18rpx}.recap{display:flex;gap:24rpx;align-items:center;padding:24rpx 0;border-top:1rpx solid #e0e7e1}.recap .number{font-size:53rpx;color:#789382}

.resource-cover{height:360rpx}.resource-feature>.small{color:#506655;margin:0 28rpx 26rpx}
