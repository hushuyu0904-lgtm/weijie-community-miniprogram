page{background:#fff}.resource-scroll{width:100%}.resource-filters{display:flex;gap:7px;padding:18px 0 10px;white-space:nowrap}.resource-filter{display:flex;flex:none;align-items:center;gap:5px;margin:0;min-height:44px;padding:8px 10px;font-size:14px;background:#f0f4f1;border-radius:7px;font-weight:600;color:#304f3d}.resource-filter image{width:20px;height:20px}.resource-filter.selected{background:#1bea91;color:#123e28}.resource-panel{padding-top:7px}.source-card{padding:18px 0;border-bottom:1px solid #e1e8e3}.source-top{display:flex;align-items:center;gap:8px;font-size:12px;color:#426452}.source-top image{width:24px;height:24px}.source-kind{background:#e7f2ea;padding:2px 6px;border-radius:3px}.source-title{margin:9px 0;font-size:19px;line-height:1.45;font-weight:700}.source-desc{margin:5px 0;color:#59685f;font-size:12px}.source-action{color:#087649;font-size:13px;font-weight:600;margin:10px 0 0;padding:10px 0;min-height:44px;background:none;text-align:left}.resource-feature{background:#f1f6f2;color:#243b2d;padding:0 0 18px;overflow:hidden;border:1px solid #e2eae3;border-radius:8px}.knowledge-link{display:block;background:#fff;border-bottom:1px solid #e2eae3;border-radius:0;margin:0;padding:0;text-align:left;line-height:1.65}.knowledge-link image{display:block;width:100%}.knowledge-caption{font-size:11px;padding:8px 13px;color:#376548}.feature-title{font-size:18px;font-weight:700;margin:12px 14px 6px;line-height:1.3}.feature-desc{font-size:13px;margin:0 14px 8px}.resource-feature>.small{color:#506759;margin:0 17px}.resource-caption{font-size:12px;color:#5b685f;margin-top:10px}.tool-card{display:flex;gap:13px;padding:18px 15px;background:#eef6f1;border:1px solid #dce9e0;border-radius:9px;margin:20px 0}.tool-card>image{width:30px;height:30px;flex:none}.tool-title{font-weight:700;font-size:16px}.tool-card .small{margin:5px 0 9px}.recap{display:flex;gap:24rpx;align-items:center;padding:24rpx 0;border-top:1rpx solid #e0e7e1}.recap .number{font-size:30px;color:#789382}
.resource-filters{gap:5px;width:100%;box-sizing:border-box}.resource-filter{flex:1;min-width:0;justify-content:center;padding:8px 0;gap:3px;font-size:13px;box-sizing:border-box}.resource-filter image{width:16px;height:16px;flex-shrink:0}@media(max-width:340px){.resource-filter{font-size:12px;gap:2px}.resource-filter image{width:14px;height:14px}}
