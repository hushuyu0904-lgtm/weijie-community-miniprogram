<view class="tab-page"><view class="masthead"><view class="kicker">未界 / RESOURCES</view><view class="page-heading">资源</view><view class="deck editorial">职业方向、亲身经历与新的机会。</view></view><view class="page-body">
<scroll-view scroll-x="{{false}}" class="resource-scroll"><view class="resource-filters"><button wx:for="{{categories}}" wx:key="id" class="resource-filter {{category === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectCategory"><image src="/assets/editorial/{{item.icon}}.png"/><text>{{item.label}}</text></button></view></scroll-view>
<view wx:if="{{status === 'loading'}}" class="state">资源加载中…</view><view wx:elif="{{status === 'error'}}" class="state"><view class="status-empty-title">暂时无法加载资源</view><view>{{error}}</view><button class="primary" bindtap="loadResources">重试</button></view><view wx:elif="{{status === 'empty'}}" class="state"><view class="status-empty-title">这一分类暂时还没有发布资源</view><view class="muted">你可以切换分类，或稍后再回来看看。</view><button class="secondary" bindtap="loadResources">重新加载</button></view>
<block wx:else><button wx:for="{{items}}" wx:key="id" class="source-card resource-card" data-id="{{item.id}}" bindtap="openResource"><image wx:if="{{item.coverUrl}}" class="resource-cover-thumb" src="{{item.coverUrl}}" mode="aspectFill"/><view class="source-top"><view class="source-avatar">{{item.sourceInitial}}</view><view class="source-meta"><text class="source-name">{{item.sourceLabel || '未界编辑部'}}</text><text class="source-type">{{item.category === 'opportunity' ? '机会' : item.category === 'news' ? '行业资讯' : item.category === 'knowledge' ? '知识库' : '活动回顾'}}</text></view></view><view class="source-title">{{item.title}}</view><view class="source-desc">{{item.summary}}</view><view class="source-action">阅读全文 <text>→</text></view></button><view wx:if="{{moreError}}" class="notice form-error">{{moreError}}</view><button wx:if="{{hasMore}}" class="secondary" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">{{moreError ? '重试加载更多' : '加载更多'}}</button></block>
</view></view>
