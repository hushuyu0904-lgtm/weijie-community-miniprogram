.resource-editor-page{padding-bottom:120rpx}.editor-card{margin-top:22rpx}.editor-row{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.editor-row .subtitle{margin:0}.compact-button{margin:0;min-height:66rpx;padding:10rpx 18rpx;font-size:25rpx;white-space:nowrap}.cover-preview{display:block;width:100%;height:300rpx;border-radius:12rpx;background:#e9f0eb;margin-top:18rpx}.editor-empty{padding:28rpx 18rpx;background:#f3f7f4;color:#5b685f;font-size:26rpx;border-radius:10rpx;margin:16rpx 0}.block-editor{padding:18rpx 0;border-bottom:1rpx solid #e3e9e4}.block-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10rpx;color:#466451;font-size:24rpx;font-weight:700}.block-toolbar>view{display:flex;gap:8rpx}.block-action{margin:0;min-height:54rpx;padding:7rpx 12rpx;background:#eef4ef;color:#42614e;font-size:23rpx}.block-action.danger{color:#9c3e3e;background:#fff1f1}.block-textarea{height:190rpx;margin:14rpx 0 0;border-color:#cbd8cf;line-height:1.75}.block-textarea.heading{height:92rpx;font-size:32rpx;font-weight:700}.block-textarea.quote{height:128rpx;background:#f4f8f5;border-left:5rpx solid #7bb28d}.block-image{display:block;width:100%;border-radius:10rpx;background:#e9f0eb;margin-top:14rpx}.block-adders{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.block-adders button{margin:0;min-height:66rpx;padding:10rpx 16rpx;font-size:24rpx}.resource-editor-page>.primary,.resource-editor-page>.secondary{width:100%}
