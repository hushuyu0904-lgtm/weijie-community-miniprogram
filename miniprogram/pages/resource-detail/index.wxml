<view class="page resource-detail-page"><view wx:if="{{status === 'loading'}}" class="state">资源加载中…</view><view wx:elif="{{status === 'error'}}" class="state"><view class="status-empty-title">暂时无法打开这条资源</view><view>{{error}}</view><button class="primary" bindtap="load">重试</button></view><block wx:else><view class="resource-type">{{item.categoryLabel}}</view><view class="title">{{item.title}}</view><view class="resource-summary">{{item.summary}}</view><view wx:if="{{item.content}}" class="resource-reading body">{{item.content}}</view><view wx:else class="resource-reading muted">这条资源以来源链接为主；复制链接后可在浏览器继续阅读。</view><view wx:if="{{item.sourceLabel}}" class="source-box"><view class="label">内容来源</view><view>{{item.sourceLabel}}</view></view><button wx:if="{{item.sourceUrl}}" class="primary" bindtap="copySource">复制来源链接</button><view wx:if="{{item.sourceUrl}}" class="form-hint">外部网页请复制链接后在浏览器打开。</view></block></view>
