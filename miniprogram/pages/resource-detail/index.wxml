<view class="page"><view wx:if="{{status === 'loading'}}" class="state">资源加载中…</view><view wx:elif="{{status === 'error'}}" class="state"><view>{{error}}</view><button class="primary" bindtap="load">重试</button></view><view wx:else class="card"><view class="subtitle">{{item.title}}</view><view class="muted">{{item.summary}}</view><view wx:if="{{item.content}}" class="body">{{item.content}}</view><view wx:if="{{item.sourceLabel}}" class="notice">来源：{{item.sourceLabel}}</view><button wx:if="{{item.sourceUrl}}" class="secondary" bindtap="copySource">复制来源链接</button><view wx:if="{{item.sourceUrl}}" class="muted">外部网页请复制链接后在浏览器打开。</view></view></view>
