.resource-detail-page{background:#fff;padding-top:48rpx}.resource-cover{display:block;width:100%;height:400rpx;border-radius:16rpx;background:#e9f0eb;margin-bottom:26rpx}.resource-type{display:inline-block;padding:7rpx 13rpx;background:#e7f2ea;border-radius:5rpx;color:#286647;font-size:23rpx;font-weight:700}.resource-detail-page .title{font-size:48rpx;line-height:1.35;margin:20rpx 0}.resource-summary{color:#526257;font-size:30rpx;line-height:1.75;padding-bottom:28rpx;border-bottom:1rpx solid #e0e8e2}.resource-reading{margin:30rpx 0}.reading-paragraph{font-size:30rpx;line-height:1.95;margin:0 0 28rpx;white-space:pre-wrap}.reading-heading{font-size:38rpx;line-height:1.45;font-weight:800;margin:46rpx 0 18rpx}.reading-quote{padding:18rpx 22rpx;border-left:6rpx solid #7bb28d;background:#f2f7f3;color:#3d5747;font-size:29rpx;line-height:1.8;margin:28rpx 0;white-space:pre-wrap}.reading-image{display:block;width:100%;border-radius:12rpx;background:#e9f0eb;margin:28rpx 0}.reading-image-unavailable{padding:24rpx;text-align:center;background:#f3f6f4;color:#5b685f;border-radius:10rpx;margin:28rpx 0}.source-box{padding:22rpx 24rpx;background:#f2f7f3;border-radius:12rpx;color:#345644}.source-box .label{margin-bottom:5rpx}.resource-detail-page .primary{width:100%;margin-top:30rpx}
