.resource-detail-page{background:#fff;padding-top:48rpx}.resource-type{display:inline-block;padding:7rpx 13rpx;background:#e7f2ea;border-radius:5rpx;color:#286647;font-size:23rpx;font-weight:700}.resource-detail-page .title{font-size:48rpx;line-height:1.35;margin:20rpx 0}.resource-summary{color:#526257;font-size:30rpx;line-height:1.75;padding-bottom:28rpx;border-bottom:1rpx solid #e0e8e2}.resource-reading{margin:30rpx 0;font-size:30rpx;line-height:1.9}.source-box{padding:22rpx 24rpx;background:#f2f7f3;border-radius:12rpx;color:#345644}.source-box .label{margin-bottom:5rpx}.resource-detail-page .primary{width:100%;margin-top:30rpx}
