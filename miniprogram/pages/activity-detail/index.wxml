<view class="page detail-page">
  <button class="secondary back" bindtap="goBack">返回活动列表</button>
  <view class="notice">{{sourceLabel}}</view>
  <view wx:if="{{status === 'loading'}}" class="state">加载中…</view>
  <view wx:elif="{{status === 'error'}}" class="state">
    <view>{{error}}</view>
    <button class="primary" bindtap="loadActivity">重试</button>
  </view>
  <view wx:elif="{{status === 'missing'}}" class="state">活动不存在或链接无效，请返回活动列表。</view>
  <block wx:else>
  <view class="detail-coffee llm-frame" wx:if="{{activity.isDemo && activity.category === 'lecture'}}"><image wx:if="{{!coverFailed}}" class="llm-art" src="/assets/editorial/llm-exchange.jpg" mode="aspectFill" binderror="onCoverError" /><view wx:else class="llm-fallback">大模型交流<view class="small">封面暂不可用</view></view><text class="photo-note llm-note">AI 生成主题配图</text></view><view class="detail-coffee" wx:elif="{{activity.isDemo}}"><image wx:if="{{!coverFailed}}" src="/assets/editorial/coffee-chat.jpg" mode="aspectFill" binderror="onCoverError"/><text class="photo-note">图库主题配图 · 非活动现场</text></view><view class="card detail-heading">
    <view class="muted">{{activity.isDemo ? '示例活动' : '已发布活动'}}</view>
    <view class="title">{{activity.title}}</view>
    <view class="field"><text class="label">时间</text>{{activity.timeText}}</view>
    <view class="field"><text class="label">地点</text>{{activity.location}}</view>
    <view class="field"><text class="label">费用</text><text class="price">{{activity.priceText}}</text></view>
  </view>
  <view class="card">
    <view class="subtitle">活动介绍</view>
    <view class="body">{{activity.description}}</view>
  </view>
  <view class="card">
    <view class="subtitle">参与说明</view>
    <view class="field"><text class="label">人数上限</text>{{activity.capacity}} 人{{activity.isDemo ? '（示例）' : ''}}</view>
    <view class="field"><text class="label">报名截止</text>{{activity.deadlineText}}</view>
    <view class="muted">仅限本人报名一个名额。</view>
    <view wx:if="{{activity.priceFen > 0}}" class="notice">该活动包含收费信息，首发仅支持免费活动，目前不能报名或付款。</view>
  </view>
  <view class="registration-bar">
    <view class="closed">报名功能尚未开放</view>
  </view>
  </block>
</view>
