<view class="tab-page">
  <view class="masthead"><view class="kicker">未界 / CONNECTION</view><view class="page-heading">连接申请</view><view class="deck editorial">相似的背景，不一样的故事。</view></view>
  <view class="page-body">
    <view class="connect-poster"><view class="conversation-photo"><image wx:if="{{!coverFailed}}" src="/assets/editorial/conversation.jpg" mode="aspectFill" binderror="onCoverError"/><view wx:else class="state">交流主题配图暂不可用</view><text class="photo-note">图库主题配图 · 非活动现场</text></view><view class="connect-title">认识一个人，<view>听听另一种经历。</view></view><view class="connect-caption">由未界协助安排的 Peer Coffee Chat</view>
      <view wx:if="{{status === 'loading'}}" class="state">正在验证身份…</view>
      <view wx:elif="{{status === 'error'}}" class="state"><view class="status-empty-title">暂时无法打开连接申请</view><view>{{error}}</view><button class="primary" bindtap="load">重试</button></view>
      <view wx:elif="{{!identity.hasProfile}}" class="card"><view class="subtitle">先建立职业档案</view><view class="muted">连接申请需要一份最小职业画像，方便运营判断是否适合撮合。</view><button class="primary" bindtap="openOnboarding">填写职业档案</button></view>
      <block wx:else><view class="status-pill">运营协助安排</view><button class="primary application-open" bindtap="toggleForm">{{formOpen ? '收起申请表' : '填写交流申请'}}</button><button class="secondary application-open" bindtap="openMine">查看我的申请</button><view wx:if="{{message}}" class="notice">{{message}}</view><view wx:if="{{error}}" class="notice form-error">{{error}}</view>
        <view wx:if="{{formOpen}}" class="application-form"><view class="subtitle">{{form.intent === 'seek' ? '我想认识这样的人' : '我愿意分享这些经历'}}</view><view class="form-note">{{form.intent === 'seek' ? '写下你的现状和想了解的问题，方便我们理解这次交流期待。' : '写下你走过的路径和愿意分享的话题，方便我们寻找合适的交流对象。'}}</view><view class="label">我希望</view><view class="choice-row"><button class="choice {{form.intent === 'seek' ? 'selected' : ''}}" data-id="seek" bindtap="selectIntent">寻找相似背景的人聊聊</button><button class="choice {{form.intent === 'share' ? 'selected' : ''}}" data-id="share" bindtap="selectIntent">分享我的转行经历</button></view><view class="label">感兴趣方向 *（至少选 1 个，最多选 5 个）</view><view class="form-hint">{{form.intent === 'seek' ? '选择这次最想探索的方向。' : '选择你最愿意分享的方向。'}}</view><checkbox-group class="direction-grid" bindchange="selectDirections"><label wx:for="{{directions}}" wx:key="id" class="direction-choice {{item.checked ? 'selected' : ''}}"><checkbox value="{{item.id}}" checked="{{item.checked}}"/> <text>{{item.label}}</text></label></checkbox-group><label class="label">{{form.intent === 'seek' ? '你的当前情况 *' : '你愿意分享的经历 *'}}</label><textarea value="{{form.introduction}}" data-field="introduction" bindinput="input" maxlength="1500" placeholder="{{form.intent === 'seek' ? '例如：临床医学研二，正在探索医疗 AI 产品方向。' : '例如：我从临床转到医疗 AI 的第一份工作，以及一路上的尝试。'}}"/><label class="label">{{form.intent === 'seek' ? '这次最想了解什么？*' : '你想和什么样的人交流？*'}}</label><textarea value="{{form.question}}" data-field="question" bindinput="input" maxlength="1000" placeholder="{{form.intent === 'seek' ? '例如：我想了解进入医疗 AI 的第一份工作如何准备。' : '例如：正在考虑转向医疗 AI、希望听真实经历的医学背景同学。'}}"/><label class="label">可交流时间（可选）</label><input value="{{form.availability}}" data-field="availability" bindinput="input" maxlength="300" placeholder="例如：工作日晚上或周末下午"/><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{form.intent === 'seek' ? '提交交流申请' : '提交分享意愿'}}</button></view>
      </block>
    </view>
    <view class="section-head"><view class="subtitle">一次交流，如何开始</view></view><view class="step"><text class="number">01</text><view><view class="flat-title">留下交流期待</view><view class="small">职业方向、背景和希望交流的问题。</view></view></view><view class="step"><text class="number">02</text><view><view class="flat-title">未界了解双方需求</view><view class="small">运营核实背景和交流意愿。</view></view></view><view class="step"><text class="number">03</text><view><view class="flat-title">确认后安排交流</view><view class="small">我们将与双方分别确认时间。</view></view></view>
  </view>
</view>
