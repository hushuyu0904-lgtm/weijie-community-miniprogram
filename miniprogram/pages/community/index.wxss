page{background:#fff}.connect-poster{background:#fff;padding:0;margin-top:18px}.conversation-photo{position:relative;margin:0 0 16px;border-radius:8px;overflow:hidden;background:#e5eee8;height:calc((100vw - 64rpx) / 2.5)}.conversation-photo image{display:block;width:100%;height:100%}.connect-title{font-size:25px;line-height:1.35;font-weight:750;letter-spacing:-.4px;color:#243b2d}.connect-caption{font-size:14px;color:#56665b;margin:12px 0}.connect-poster>.status-pill{background:#edf2ee;color:#516557;padding:5px 9px;display:inline-block}.application-open{width:100%;margin-top:15px;font-size:15px;min-height:46px;padding:10px}.connect-poster>.small{margin:9px 0}.interest-card{display:flex;align-items:flex-start;gap:13px;padding:18px 15px;background:#eef6f1;border:1px solid #dce9e0;border-radius:9px;margin:20px 0}.interest-card>image{width:30px;height:30px;flex:none}.interest-title{font-size:17px;font-weight:700}.interest-card .small{margin:5px 0 9px}.step{display:flex;gap:16px;padding:17px 0;border-bottom:1px solid #e1e7e2}.step .number{font-size:32px;color:#55977a;min-width:34px}.step .small{margin-top:4px}.application-form{border-top:1px solid #dce9e0;margin-top:24px;padding-top:18px}.form-note{font-size:12px;color:#536759;background:#f1f5f2;padding:12px;border-radius:6px}.form-field{margin-top:15px}.form-field label{display:block;font-size:14px;color:#2d4736;font-weight:600}.form-field input,.form-field textarea{font-size:15px;line-height:1.65;margin:7px 0 16px;padding:11px;font-weight:400;box-sizing:border-box}.form-field input{height:48px}.form-field textarea{height:120px}.application-form button{font-size:14px;padding:11px;min-height:44px;margin-top:10px;width:100%}.resume-unavailable{background:#edf0ee;color:#55685c}.form-result{font-size:13px;color:#305d43;margin:12px 0}@media(max-width:340px){.connect-title{font-size:26px}}
