.connect-poster{margin-top:28rpx;background:#e2dbf5;border-radius:16rpx;padding:32rpx;color:#382c54}.connect-circles{display:flex;align-items:center;margin-bottom:28rpx}.connect-circles image{width:100rpx;height:100rpx;padding:22rpx;border-radius:50%;background:#ffffffd9}.connect-line{height:2rpx;width:100rpx;background:#927fab;margin:0 16rpx}.connect-title{font-size:45rpx;line-height:1.35;font-weight:700}.connect-caption{font-size:28rpx;margin:18rpx 0 25rpx}.connect-poster .status-pill{background:#ffffffb8;color:#594a6f;display:inline-block}.step{display:flex;gap:25rpx;padding:22rpx 0;border-bottom:1rpx solid #e1e7e2}.step .number{font-size:49rpx;color:#8876a0;min-width:66rpx}.step .small{margin-top:8rpx;font-size:25rpx}
