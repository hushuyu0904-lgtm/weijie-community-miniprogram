page{background:#fff}.connect-poster{background:#fff;padding:0;margin-top:18px}.conversation-photo{position:relative;margin:0 0 16px;border-radius:8px;overflow:hidden;background:#e5eee8;height:calc((100vw - 64rpx) / 2.5)}.conversation-photo image{display:block;width:100%;height:100%}.connect-title{font-size:25px;line-height:1.35;font-weight:750;letter-spacing:-.4px;color:#243b2d}.connect-caption{font-size:14px;color:#56665b;margin:12px 0}.connect-poster>.status-pill{background:#edf2ee;color:#516557;padding:5px 9px;display:inline-block}.application-open{width:100%;margin-top:15px;font-size:15px;min-height:46px;padding:10px}.connect-poster>.small{margin:9px 0}.interest-card{display:flex;align-items:flex-start;gap:13px;padding:18px 15px;background:#eef6f1;border:1px solid #dce9e0;border-radius:9px;margin:20px 0}.interest-card>image{width:30px;height:30px;flex:none}.interest-title{font-size:17px;font-weight:700}.interest-card .small{margin:5px 0 9px}.step{display:flex;gap:16px;padding:17px 0;border-bottom:1px solid #e1e7e2}.step .number{font-size:32px;color:#55977a;min-width:34px}.step .small{margin-top:4px}.application-form{border-top:1px solid #dce9e0;margin-top:24px;padding-top:22px}.form-note{font-size:12px;color:#536759;background:#f1f5f2;padding:12px;border-radius:6px;margin-bottom:20px}.application-form>.label{margin-top:24px;color:#2d4736;font-size:14px;font-weight:700}.application-form input,.application-form textarea{font-size:15px;line-height:1.65;margin:8px 0 10px;padding:15px 13px;font-weight:400;box-sizing:border-box;border-color:#c7d6cc}.application-form input{height:52px}.application-form textarea{height:138px}.application-form button{font-size:14px;padding:11px;min-height:44px;margin-top:12px;width:100%}.direction-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:10px 0 6px}.direction-choice{display:flex;align-items:center;min-width:0;min-height:44px;box-sizing:border-box;padding:10px 8px;border:1px solid #d7e2da;border-radius:8px;background:#fff;color:#405648;font-size:12px;line-height:1.35}.direction-choice checkbox{transform:scale(.72);flex:none;margin-right:2px}.direction-choice text{min-width:0;overflow-wrap:anywhere}.direction-choice.selected{border-color:#187552;background:#eaf7ef;color:#155f42;font-weight:600}.resume-unavailable{background:#edf0ee;color:#55685c}.form-result{font-size:13px;color:#305d43;margin:12px 0}@media(max-width:340px){.connect-title{font-size:26px}.direction-grid{grid-template-columns:1fr}.direction-choice{font-size:13px}}
