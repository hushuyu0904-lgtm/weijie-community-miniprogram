page { background: #faf8f3; color: #30253e; font-size: 30rpx; line-height: 1.65; }
.page { padding: 32rpx; padding-bottom: 56rpx; }
.brand { font-size: 48rpx; font-weight: 700; letter-spacing: 8rpx; }
.title { font-size: 40rpx; font-weight: 700; line-height: 1.45; margin: 20rpx 0; }
.subtitle { font-size: 34rpx; font-weight: 600; margin: 8rpx 0 16rpx; }
.muted { color: #716978; }
.notice { padding: 20rpx 24rpx; border-radius: 16rpx; background: #eee5f5; color: #514164; font-size: 26rpx; margin: 20rpx 0 28rpx; }
.card { background: #fff; border: 1rpx solid #e8e1ed; border-radius: 28rpx; padding: 32rpx; margin: 24rpx 0; overflow-wrap: break-word; }
.price { color: #7046ac; font-size: 34rpx; font-weight: 600; margin: 16rpx 0; }
.field { margin: 16rpx 0; }
.label { display: block; color: #716978; font-size: 26rpx; }
.body { white-space: pre-wrap; overflow-wrap: break-word; }
.state { padding: 48rpx 24rpx; text-align: center; }
button { font-size: 30rpx; min-height: 96rpx; line-height: 1.5; padding: 24rpx; border-radius: 18rpx; margin-top: 24rpx; }
button::after { border: none; }
.primary { background: #7046ac; color: #fff; font-weight: 600; }
.secondary { background: #eee5f5; color: #514164; }
.back { margin: 0 0 24rpx; }
.closed { padding: 24rpx; border-radius: 16rpx; background: #eeeaf0; color: #514164; text-align: center; }
input, textarea { display: block; width: 100%; box-sizing: border-box; border: 1rpx solid #bcb2c5; border-radius: 14rpx; background: #fff; color: #30253e; padding: 20rpx; margin: 12rpx 0 28rpx; font-size: 30rpx; }
input { height: 96rpx; }
textarea { height: 220rpx; }
button[disabled] { opacity: 0.6; }
