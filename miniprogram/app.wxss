/* v0.1 editorial system: quiet paper, ink and one restrained accent */
page{background:#faf9f6;color:#202421;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
.page{padding:32rpx;padding-bottom:calc(180rpx + env(safe-area-inset-bottom))}
.masthead{padding:34rpx 32rpx 27rpx;background:#f1f0ea;border-bottom:1rpx solid #d9d8cf}
.kicker{font-size:20rpx;letter-spacing:2.6rpx;color:#596057}
.page-heading{font-family:"Songti SC","STSong","SimSun",serif;font-size:56rpx;font-weight:700;letter-spacing:-1rpx}
.deck{color:#62665f;font-size:28rpx}.editorial{font-family:"Songti SC","STSong","SimSun",serif}
.title,.subtitle{color:#202421}.title{font-family:"Songti SC","STSong","SimSun",serif;font-weight:700}.subtitle{font-weight:650}
.card{background:transparent;border:0;border-radius:0;padding:28rpx 0;margin:0;border-bottom:1rpx solid #dad8d0}
.notice{background:#f1f0ea;border-left:4rpx solid #556b5a;color:#3f4b42;border-radius:0}
.primary{background:#263c31;color:#fff;font-weight:600;border-radius:4rpx}.secondary{background:transparent;color:#263c31;border:1rpx solid #9ba398;border-radius:4rpx}
button{border-radius:4rpx}.closed{background:#efeee8;color:#50584f;border-radius:0}.status-pill{background:#efeee8;color:#50584f;border-radius:2rpx}
input,textarea{border-color:#b8b8ae;border-radius:3rpx;background:#fffefa}.choice{background:#efeee8;color:#3d483f;border-radius:3rpx}.choice.selected{background:#263c31;color:#fff}
.flat-row{border-bottom-color:#dad8d0}.flat-icon{background:#efeee8;border-radius:3rpx}.feature,.mini-tile{border-radius:3rpx}.feature{background:#263c31}.mini-tile{border-color:#dad8d0}
.photo-note{border-radius:0;background:#faf9f6e8;color:#495049}.link-button{color:#263c31}
.choice-row{display:flex;flex-wrap:wrap;gap:12rpx;margin:12rpx 0 28rpx}.choice{margin:0;min-height:64rpx;padding:12rpx 18rpx;background:#edf2ee;color:#355443;font-size:25rpx}.choice.selected{background:#117a51;color:#fff}
.link-button{display:inline-block;margin:12rpx 0 0;padding:8rpx 0;min-height:unset;background:transparent;color:#08764b;font-size:26rpx;font-weight:600;text-align:left;text-decoration:underline}.link-button[disabled]{background:transparent}.form-hint{font-size:23rpx;color:#66736a;margin:-16rpx 0 18rpx}.form-error{color:#a33333;background:#fff0f0;border-left-color:#df6767}.legal-footer{padding:12rpx 0 20rpx;text-align:center;font-size:23rpx;color:#647068}.legal-footer button{margin:0 12rpx;min-height:unset;padding:8rpx 0;background:transparent;color:#456b55;font-size:23rpx;text-decoration:underline}.legal-section{margin:30rpx 0}.legal-section .subtitle{margin-bottom:10rpx}.legal-list{padding-left:1.3em;color:#405347;font-size:27rpx}.legal-list view{margin:12rpx 0}.feedback-address{padding:22rpx;background:#edf6ef;border-radius:12rpx;color:#28543d;font-weight:600}.status-empty-title{font-size:34rpx;font-weight:700;margin-bottom:12rpx}
